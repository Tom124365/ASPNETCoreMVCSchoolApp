@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Student Grade Report";
}

<h1>Student Grades Report</h1>

<p>Select a course to generate a PDF report of its enrolled students.</p>

<form method="get" action="/Reports/Pdf">
    <div class="mb-3">
        <label for="courseId" class="form-label">Course</label>

        @Html.DropDownList(
            "courseId",
            (IEnumerable<SelectListItem>)ViewBag.Courses,
            "-- Select a course --",
            new
            {
                @class = "form-select",
                required = "required"
            })
    </div>

    <button type="submit" class="btn btn-primary">
        Generate PDF
    </button>
</form>